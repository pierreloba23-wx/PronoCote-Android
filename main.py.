    def analyze(self, *_):
        home = self.home.text.strip()
        away = self.away.text.strip()

        if not home or not away or norm(home) == norm(away):
            self.popup(
                "Informations manquantes",
                "Saisis deux équipes différentes."
            )
            return

        try:
            if self.mode.text.startswith("Automatique"):
                if not self.api_key:
                    raise ValueError(
                        "Enregistre d'abord ta clé API dans la page Clé API."
                    )

                sports = self.get_sports()
                key = self.find_sport_key(
                    self.league.text,
                    sports
                )

                if not key:
                    raise ValueError(
                        "Championnat non trouvé parmi les compétitions disponibles. "
                        "Vérifie son nom."
                    )

                event = self.find_event(key, home, away)

                if not event:
                    raise ValueError(
                        "Match non trouvé dans les événements disponibles."
                    )

                prices = self.market_prices(event, "h2h")
                eh = event["home_team"]
                ea = event["away_team"]

                if norm(home) == norm(eh):
                    odds = [
                        prices.get(eh),
                        prices.get("Draw"),
                        prices.get(ea)
                    ]
                else:
                    odds = [
                        prices.get(ea),
                        prices.get("Draw"),
                        prices.get(eh)
                    ]

                if not all(odds):
                    raise ValueError(
                        "Cotes 1/X/2 indisponibles pour ce match."
                    )

                probs = implied(odds)

                diff = max(
                    -0.8,
                    min(0.8, (probs[0] - probs[2]) * 1.5)
                )

                share = 0.5 + diff * 0.22
                total_goals = 2.55

                lh = max(.15, total_goals * share)
                la = max(.15, total_goals * (1 - share))

                source = "Cotes bookmakers The Odds API"

            else:
                odds = [
                    float(self.o1.text.replace(",", ".")),
                    float(self.ox.text.replace(",", ".")),
                    float(self.o2.text.replace(",", "."))
                ]

                lh = float(self.lh.text.replace(",", "."))
                la = float(self.la.text.replace(",", "."))

                if all(x > 1 for x in odds):
                    probs = implied(odds)
                else:
                    temp = model(lh, la)
                    probs = [
                        temp["home"],
                        temp["draw"],
                        temp["away"]
                    ]

                source = "Saisie manuelle / modèle de Poisson"

            pred = model(lh, la)

            self.render_result(
                home,
                away,
                odds,
                probs,
                pred,
                source,
                self.scorers.text
            )

        except Exception as e:
            self.popup("Analyse impossible", str(e))

