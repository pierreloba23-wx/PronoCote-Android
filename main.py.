        add(f"1 / N / 2 à la pause : {half['home']*100:.1f}% / {half['draw']*100:.1f}% / {half['away']*100:.1f}%")
        add("TENDANCE", 32, 16)
        add(f"1 : {probs[0]*100:.1f}%   Nul : {probs[1]*100:.1f}%   2 : {probs[2]*100:.1f}%")
        if max(probs) < .45: add("Match équilibré : prudence, probabilité peu tranchée.")
        add("Probabilités indicatives, jamais une garantie de résultat.", 42, 11)

    def api_get(self, path, params=None):
        if not self.odds_key: raise ValueError("Clé The Odds API absente.")
        p = dict(params or {}); p["apiKey"] = self.odds_key
        r = requests.get(API_BASE+path, params=p, timeout=20)
        if r.status_code == 401: raise ValueError("Clé API refusée.")
        if r.status_code == 429: raise ValueError("Quota API atteint.")
        r.raise_for_status()
        return r.json()

    def get_sports(self):
        return [s for s in self.api_get("/sports/", {"all":"false"}) if s.get("active")]

    def find_sport_key(self, league, sports):
        if not league.strip(): return None
        best = max(sports, key=lambda s: max(sim(league,s.get("title","")),sim(league,s.get("key",""))), default=None)
        if best and max(sim(league,best.get("title","")),sim(league,best.get("key",""))) >= .42:
            return best["key"]
        return None

    def find_event(self, sport_key, home, away):
        events = self.api_get(f"/sports/{sport_key}/odds/", {"regions":"eu","markets":"h2h","oddsFormat":"decimal"})
        best, score = None, 0
        for e in events:
            s = (sim(home,e.get("home_team",""))+sim(away,e.get("away_team","")))/2
            s = max(s,(sim(home,e.get("away_team",""))+sim(away,e.get("home_team","")))/2)
            if s > score: best, score = e, s
        return best if score >= .72 else None

    def market_prices(self, event, market_key):
        vals = {}
        for book in event.get("bookmakers",[]):
            for market in book.get("markets",[]):
                if market.get("key") == market_key:
                    for out in market.get("outcomes",[]):
                        vals.setdefault(out["name"],[]).append(out["price"])
        return {k:sum(v)/len(v) for k,v in vals.items() if v}

