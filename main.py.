        for line in (0.5,1.5,2.5,3.5):
            add(f"Plus de {line} : {pred['over'][line]*100:.1f}%   |   Moins de {line} : {pred['under'][line]*100:.1f}%")
        add("ESTIMATION MI-TEMPS", 32, 16)
        half = model(max(.05, float(self.lh.text.replace(',', '.')) * .45), max(.05, float(self.la.text.replace(',', '.')) * .45))
