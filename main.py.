        self.aaod = self.field("Cote extérieur de départ", "2.50")

        self.alert_league = self.field(
            "Championnat / compétition (pour suivi API)"
        )

        for w in (
            self.ah,
            self.aa,
            self.ahod,
            self.aaod,
            self.alert_league
        ):
            box.add_widget(w)

        box.add_widget(
            self.button(
                "🔔 ACTIVER L'ALERTE",
                self.add_alert,
                True
            )
        )

        auto_row = BoxLayout(
            size_hint_y=None,
            height=dp(42)
        )

        auto_row.add_widget(
            self.label(
                "Auto : vérifier toutes les 2 minutes",
                42, 13
            )
        )

        self.auto_switch = Switch(active=False)
        self.auto_switch.bind(active=self.toggle_auto)

        auto_row.add_widget(self.auto_switch)
        box.add_widget(auto_row)

        box.add_widget(
            self.label("Alertes enregistrées", 34, 16)
        )

        self.alert_list = BoxLayout(
            orientation="vertical",
            spacing=dp(5),
            size_hint_y=None
        )

        self.alert_list.bind(
            minimum_height=self.alert_list.setter("height")
        )

        box.add_widget(self.alert_list)

        box.add_widget(
            self.label("Historique", 34, 16)
        )

        box.add_widget(
            self.button(
                "Effacer l'historique",
                self.clear_history
            )
        )

        self.history_label = self.label("", 200, 12)
        self.history_label.text_size = (
            Window.width - dp(40),
            None
        )

        box.add_widget(self.history_label)

        self.refresh_alert_view()

    def add_alert(self, *_):
        try:
            h = self.ah.text.strip()
            a = self.aa.text.strip()

            oh = float(self.ahod.text.replace(",", "."))
            oa = float(self.aaod.text.replace(",", "."))

            if not h or not a:
                raise ValueError("Saisis les deux équipes.")

            if oh <= 1 or oa <= 1:
                raise ValueError(
                    "Les cotes doivent être supérieures à 1."
                )

            self.alerts.append({
                "home": h,
                "away": a,
                "home_odds": oh,
                "away_odds": oa,
                "league": self.alert_league.text.strip(),
                "active": True
            })

            self.save_all()
            self.refresh_alert_view()

            self.popup(
                "Alerte activée",
                "Les cotes de départ ont été enregistrées."
            )

        except Exception as e:
            self.popup("Erreur", str(e))

    def refresh_alert_view(self):
        if not hasattr(self, "alert_list"):
            return

        self.alert_list.clear_widgets()

        for i, al in enumerate(self.alerts):
            row = BoxLayout(
                size_hint_y=None,
                height=dp(48),
                spacing=dp(4)
            )

            row.add_widget(
                self.label(
                    f"{al['home']} – {al['away']}  "
                    f"{al['home_odds']:.2f}/{al['away_odds']:.2f}",
                    48,
                    11
                )
            )

            b = Button(
                text="X",
                size_hint_x=None,
                width=dp(42),
                background_normal="",
                background_color=(0.48, 0.16, 0.16, 1),
                color=WHITE
            )

            b.bind(
                on_release=lambda _, idx=i: self.remove_alert(idx)
            )

            row.add_widget(b)
            self.alert_list.add_widget(row)

        self.history_label.text = (
            "\n".join(x for x in self.history[:20])
            or "Aucune variation enregistrée."
        )

    def remove_alert(self, idx):
        if 0 <= idx < len(self.alerts):
            self.alerts.pop(idx)
            self.save_all()
            self.refresh_alert_view()

    def clear_history(self, *_):
        self.history = []
        self.save_all()
        self.refresh_alert_view()

    def toggle_auto(self, _, active):
        if self.auto_event:
            self.auto_event.cancel()
            self.auto_event = None

        if active:
            self.auto_event = Clock.schedule_interval(
                self.auto_check,
                POLL_SECONDS
            )
            self.auto_check(0)

    def auto_check(self, _dt):
        if (
            self.current_page != "Alertes"
            or not getattr(self, "auto_switch", None)
            or not self.auto_switch.active
        ):
            return

        if not self.api_key:
            return

        for al in self.alerts:
            try:
                sports = self.get_sports()

                key = self.find_sport_key(
                    al.get("league", ""),
                    sports
                )

                if not key:
                    continue

                event = self.find_event(
                    key,
                    al["home"],
                    al["away"]
                )

                if not event:
                    continue

                prices = self.market_prices(event, "h2h")

                eh = event["home_team"]
                ea = event["away_team"]

                nh = prices.get(eh)
                na = prices.get(ea)

                if not nh or not na:
                    continue

                if norm(al["home"]) != norm(eh):
                    nh, na = na, nh

                changes = []

                if abs(nh - al["home_odds"]) >= .01:
                    changes.append(
                        f"Cote domicile "
                        f"{'monte' if nh > al['home_odds'] else 'baisse'} : "
                        f"{al['home_odds']:.2f} → {nh:.2f}"
                    )

                if abs(na - al["away_odds"]) >= .01:
                    changes.append(
                        f"Cote extérieur "
                        f"{'monte' if na > al['away_odds'] else 'baisse'} : "
                        f"{al['away_odds']:.2f} → {na:.2f}"
                    )

                if changes:
                    msg = (
                        f"{datetime.now().strftime('%d/%m %H:%M')} · "
                        f"{al['home']} – {al['away']} · "
                        + " ; ".join(changes)
                    )

                    self.history.insert(0, msg)

                    al["home_odds"] = nh
                    al["away_odds"] = na

                    self.notify("Variation de cote", msg)

                    self.save_all()
                    self.refresh_alert_view()

            except Exception:
                continue

    def notify(self, title, message):
        try:
            from plyer import notification

            notification.notify(
                title=title,
                message=message,
                timeout=8
            )

        except Exception:
            self.popup(title, message)

    def on_stop(self):
        self.save_all()

        if self.auto_event:
            self.auto_event.cancel()


