    def analyze(self, *_):
        home, away = self.home.text.strip(), self.away.text.strip()
        if not home or not away or norm(home) == norm(away):
            self.popup("Informations manquantes", "Saisis deux équipes différentes.")
            return
        try:
            if self.mode.text.startswith("Automatique"):
                if not self.odds_key:
                    raise ValueError("Enregistre d'abord ta clé The Odds API dans la page Clés API.")
                sports = self.get_sports()
                key = self.find_sport_key(self.league.text, sports)
                if not key:
                    raise ValueError("Championnat non trouvé parmi les compétitions disponibles. Vérifie son nom.")
                event = self.find_event(key, home, away)
                if not event: raise ValueError("Match non trouvé dans les événements disponibles.")
                prices = self.market_prices(event, "h2h")
                eh, ea = event["home_team"], event["away_team"]
                if norm(home) == norm(eh):
                    odds = [prices.get(eh), prices.get("Draw"), prices.get(ea)]
                else:
                    odds = [prices.get(ea), prices.get("Draw"), prices.get(eh)]
                if not all(odds): raise ValueError("Cotes 1/X/2 indisponibles pour ce match.")
                probs = implied(odds)
                diff = max(-0.8, min(0.8, (probs[0]-probs[2])*1.5))
                share = 0.5 + diff*0.22
                total_goals = 2.55
                lh, la = max(.15,total_goals*share), max(.15,total_goals*(1-share))
                source = "Cotes bookmakers The Odds API"
            else:
                odds = [float(self.o1.text.replace(",",".")), float(self.ox.text.replace(",",".")), float(self.o2.text.replace(",","."))]
                lh, la = float(self.lh.text.replace(",",".")), float(self.la.text.replace(",","."))
                if all(x > 1 for x in odds): probs = implied(odds)
                else:
                    temp = model(lh,la); probs = [temp["home"],temp["draw"],temp["away"]]
                source = "Saisie manuelle / modèle de Poisson"
            pred = model(lh,la)
            football_context = self.get_football_context(home, away, self.match_date.text, self.league.text) if self.football_key else ""
            ai_text = self.ask_groq(home, away, probs, pred, source, football_context) if self.groq_key else ""
            self.render_result(home, away, odds, probs, pred, source, self.scorers.text, football_context, ai_text)
        except Exception as e:
            self.popup("Analyse impossible", str(e))

