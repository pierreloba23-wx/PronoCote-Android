            answer = self.groq_chat("Réponds uniquement : connexion Groq opérationnelle.")
            self.popup("Groq AI connecté", answer[:350])
        except Exception as e: self.popup("Test Groq échoué", str(e))

    def api_football_get(self, endpoint, params=None):
        if not self.football_key: raise ValueError("Clé API-Football absente.")
        r=requests.get("https://v3.football.api-sports.io/"+endpoint, headers={"x-apisports-key":self.football_key}, params=params or {}, timeout=25)
        if r.status_code in (401,403): raise ValueError("API-Football a refusé la clé ou l'accès.")
        if r.status_code == 429: raise ValueError("Quota API-Football atteint.")
        r.raise_for_status(); data=r.json()
        if data.get("errors"): raise ValueError(str(data["errors"]))
        return data.get("response", [])

    def get_football_context(self, home, away, match_date, league):
        try:
            parsed=datetime.strptime(match_date, "%d/%m/%Y").date()
            year=parsed.year
            leagues=self.api_football_get("leagues", {"search":league}) if league.strip() else []
            league_item=next((x for x in leagues if x.get("league",{}).get("type")=="League"), leagues[0] if leagues else None)
            if not league_item: return "Compétition non identifiée par API-Football."
            lid=league_item["league"]["id"]
            fixtures=self.api_football_get("fixtures", {"date":parsed.isoformat(),"league":lid,"season":year})
            match=None
            for f in fixtures:
                th=f.get("teams",{}).get("home",{}).get("name",""); ta=f.get("teams",{}).get("away",{}).get("name","")
                if (sim(home,th)+sim(away,ta))/2>.68 or (sim(home,ta)+sim(away,th))/2>.78:
                    match=f; break
            if not match: return f"API-Football : compétition trouvée ({league_item['league']['name']}), mais aucun match correspondant trouvé à cette date."
            teams=match.get("teams",{}); fixture=match.get("fixture",{}); goals=match.get("goals",{})
            return "\n".join([f"Match trouvé : {teams['home']['name']} - {teams['away']['name']}",f"Statut : {fixture.get('status',{}).get('long','inconnu')}",f"Score disponible : {goals.get('home','-')} - {goals.get('away','-')}",f"Identifiant match : {fixture.get('id')}"])
        except Exception as e:
            return "API-Football : " + str(e)

    def groq_chat(self, prompt):
        if not self.groq_key: raise ValueError("Clé Groq absente.")
        r=requests.post("https://api.groq.com/openai/v1/chat/completions", headers={"Authorization":"Bearer "+self.groq_key,"Content-Type":"application/json"}, json={"model":"llama-3.3-70b-versatile","messages":[{"role":"system","content":"Tu es un analyste de football prudent. N'invente jamais des statistiques, blessures, compositions ou buteurs. Distingue les données vérifiées des estimations."},{"role":"user","content":prompt}],"temperature":0.2,"max_tokens":450}, timeout=35)
        if r.status_code in (401,403): raise ValueError("Clé Groq invalide ou accès refusé.")
        if r.status_code == 429: raise ValueError("Limite d'utilisation Groq atteinte.")
        r.raise_for_status(); return r.json()["choices"][0]["message"]["content"].strip()

    def ask_groq(self, home, away, probs, pred, source, football_context):
        prompt=(f"Analyse ce match : {home} contre {away}. Source : {source}. "
                f"Probabilités 1/N/2 : {probs[0]*100:.1f}% / {probs[1]*100:.1f}% / {probs[2]*100:.1f}%. "
                f"Score Poisson indicatif : {pred['score']}. Over 2,5 : {pred['over'][2.5]*100:.1f}%. "
                f"Données API-Football : {football_context or 'non disponibles'}. "
                "Donne une synthèse courte, les limites des données et le niveau de prudence. Ne garantis jamais un résultat.")
        try: return self.groq_chat(prompt)
        except Exception as e: return "Analyse IA indisponible : " + str(e)

    def page_alerts(self):
        box = self.scroll_page()
        box.add_widget(self.label("ALERTES DE COTES", 38, 18))
        self.ah = self.field("Équipe à domicile")
        self.aa = self.field("Équipe à l'extérieur")
        self.ahod = self.field("Cote domicile de départ", "2.00")
        self.aaod = self.field("Cote extérieur de départ", "2.50")
        self.alert_league = self.field("Championnat / compétition (pour suivi API)")
        for w in (self.ah,self.aa,self.ahod,self.aaod,self.alert_league): box.add_widget(w)
        box.add_widget(self.button("🔔 ACTIVER L'ALERTE", self.add_alert, True))
        auto_row = BoxLayout(size_hint_y=None,height=dp(42))
        auto_row.add_widget(self.label("Auto : vérifier toutes les 2 minutes", 42, 13))
        self.auto_switch = Switch(active=False)
        self.auto_switch.bind(active=self.toggle_auto)
        auto_row.add_widget(self.auto_switch); box.add_widget(auto_row)
        box.add_widget(self.label("Alertes enregistrées", 34, 16))
        self.alert_list = BoxLayout(orientation="vertical", spacing=dp(5), size_hint_y=None)
        self.alert_list.bind(minimum_height=self.alert_list.setter("height"))
        box.add_widget(self.alert_list)
        box.add_widget(self.label("Historique", 34, 16))
        box.add_widget(self.button("Effacer l'historique", self.clear_history))
        self.history_label = self.label("", 200, 12)
        self.history_label.text_size = (Window.width-dp(40), None)
        box.add_widget(self.history_label)
        self.refresh_alert_view()

    def add_alert(self, *_):
        try:
            h,a = self.ah.text.strip(), self.aa.text.strip()
            oh,oa = float(self.ahod.text.replace(",",".")), float(self.aaod.text.replace(",","."))
            if not h or not a: raise ValueError("Saisis les deux équipes.")
            if oh <= 1 or oa <= 1: raise ValueError("Les cotes doivent être supérieures à 1.")
            self.alerts.append({"home":h,"away":a,"home_odds":oh,"away_odds":oa,
                                "league":self.alert_league.text.strip(),"active":True})
            self.save_all(); self.refresh_alert_view()
            self.popup("Alerte activée", "Les cotes de départ ont été enregistrées.")
        except Exception as e: self.popup("Erreur", str(e))

    def refresh_alert_view(self):
        if not hasattr(self,"alert_list"): return
        self.alert_list.clear_widgets()
        for i, al in enumerate(self.alerts):
            row = BoxLayout(size_hint_y=None,height=dp(48),spacing=dp(4))
            row.add_widget(self.label(f"{al['home']} – {al['away']}  {al['home_odds']:.2f}/{al['away_odds']:.2f}",48,11))
            b = Button(text="X", size_hint_x=None,width=dp(42), background_normal="", background_color=(0.48,0.16,0.16,1), color=WHITE)
            b.bind(on_release=lambda _, idx=i: self.remove_alert(idx))
            row.add_widget(b); self.alert_list.add_widget(row)
        self.history_label.text = "\n".join(x for x in self.history[:20]) or "Aucune variation enregistrée."

    def remove_alert(self, idx):
        if 0 <= idx < len(self.alerts):
            self.alerts.pop(idx); self.save_all(); self.refresh_alert_view()

    def clear_history(self, *_):
        self.history = []; self.save_all(); self.refresh_alert_view()

    def toggle_auto(self, _, active):
        if self.auto_event:
            self.auto_event.cancel(); self.auto_event = None
        if active:
            self.auto_event = Clock.schedule_interval(self.auto_check, POLL_SECONDS)
            self.auto_check(0)

    def auto_check(self, _dt):
        if self.current_page != "Alertes" or not getattr(self,"auto_switch",None) or not self.auto_switch.active:
            return
        if not self.odds_key: return
        for al in self.alerts:
            try:
                sports = self.get_sports()
                key = self.find_sport_key(al.get("league",""), sports)
                if not key: continue
                event = self.find_event(key,al["home"],al["away"])
                if not event: continue
                prices = self.market_prices(event,"h2h")
                eh,ea = event["home_team"],event["away_team"]
                nh,na = prices.get(eh),prices.get(ea)
                if not nh or not na: continue
                if norm(al["home"]) != norm(eh): nh,na = na,nh
                changes=[]
                if abs(nh-al["home_odds"]) >= .01:
                    changes.append(f"Cote domicile {'monte' if nh>al['home_odds'] else 'baisse'} : {al['home_odds']:.2f} → {nh:.2f}")
                if abs(na-al["away_odds"]) >= .01:
                    changes.append(f"Cote extérieur {'monte' if na>al['away_odds'] else 'baisse'} : {al['away_odds']:.2f} → {na:.2f}")
                if changes:
                    msg = f"{datetime.now().strftime('%d/%m %H:%M')} · {al['home']} – {al['away']} · " + " ; ".join(changes)
                    self.history.insert(0,msg)
                    al["home_odds"],al["away_odds"] = nh,na
                    self.notify("Variation de cote",msg)
                    self.save_all(); self.refresh_alert_view()
            except Exception:
                # Une erreur réseau/quota ne doit pas arrêter l'application.
                continue

    def notify(self, title, message):
        try:
            from plyer import notification
            notification.notify(title=title, message=message, timeout=8)
        except Exception:
            self.popup(title,message)

    def on_stop(self):
        self.save_all()
        if self.auto_event: self.auto_event.cancel()


