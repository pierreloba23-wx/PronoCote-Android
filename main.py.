def poisson(k, lam):
    return math.exp(-lam) * lam ** k / math.factorial(k)


def model(lh, la):
    ph = pd = pa = 0.0
    scores = []
    for h in range(11):
        for a in range(11):
            p = poisson(h, lh) * poisson(a, la)
            scores.append((p, h, a))
            if h > a:
                ph += p
            elif h == a:
                pd += p
            else:
                pa += p

    total = ph + pd + pa
    over, under = {}, {}

    for line in (0.5, 1.5, 2.5, 3.5):
        o = sum(
            p for p, h, a in scores if h + a > line
        ) / total
        over[line], under[line] = o, 1 - o

    best = max(scores)

    return {
        "home": ph / total,
        "draw": pd / total,
        "away": pa / total,
        "over": over,
        "under": under,
        "score": f"{best[1]} - {best[2]}",
        "score_prob": best[0] / total
    }


def implied(odds):
    inv = [1 / x for x in odds]
    s = sum(inv)
    return [x / s for x in inv]


def norm(s):
    return " ".join(
        (s or "").lower().replace("-", " ").replace(".", "").split()
    )


def sim(a, b):
    return SequenceMatcher(None, norm(a), norm(b)).ratio()


