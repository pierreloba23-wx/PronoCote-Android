        winner = home if probs[0] >= max(probs[1:]) else ("Match nul" if probs[1] >= probs[2] else away)
        goal_call = "plus de 2,5 buts" if pred["over"][2.5] >= .5 else "moins de 2,5 buts"
        add(f"PRONO : {winner} + {goal_call}", 44, 16)
